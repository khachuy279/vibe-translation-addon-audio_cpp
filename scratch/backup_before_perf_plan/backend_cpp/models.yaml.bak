default_model: qwen3-asr-1.7b
models:
  qwen3-asr-1.7b:
    name: Qwen3 ASR 1.7B (GGUF)
    family: qwen3_asr
    architecture_type: offline_llm
    hf_repo: handy-computer/Qwen3-ASR-1.7B-gguf
    default_quant: Q8_0
    file: Qwen3-ASR-1.7B-Q8_0.gguf
    sample_rate: 16000
    languages: auto
    vram_estimate_mb: 2100
    context_window_sec: 30
    description: Alibaba Audio-LLM model ported to transcribe.cpp, 1.61% WER, auto-detect
      30 languages
  sensevoice-small:
    name: SenseVoice Small (GGUF)
    family: sensevoice
    architecture_type: non_autoregressive
    hf_repo: handy-computer/SenseVoiceSmall-gguf
    default_quant: Q8_0
    file: SenseVoiceSmall-Q8_0.gguf
    sample_rate: 16000
    languages:
    - zh
    - en
    - ja
    - ko
    - yue
    vram_estimate_mb: 500
    description: Non-autoregressive speech model via transcribe.cpp, latency ~20ms
  nemotron-3.5-streaming:
    name: Nemotron 3.5 ASR Streaming (GGUF)
    family: nemotron
    architecture_type: streaming
    hf_repo: handy-computer/nemotron-3.5-asr-streaming-0.6b-gguf
    default_quant: Q8_0
    file: nemotron-3.5-asr-streaming-0.6b-Q8_0.gguf
    sample_rate: 16000
    languages: auto
    vram_estimate_mb: 750
    description: NVIDIA Multilingual streaming ASR model ported to transcribe.cpp
  qwen3-asr-1.7b-ja-bf16:
    name: Qwen3 ASR 1.7B JA (BF16)
    family: qwen3_asr
    architecture_type: offline_llm
    hf_repo: neosophie/Qwen3-ASR-1.7B-JA
    default_quant: BF16
    file: Qwen3-ASR-1.7B-JA-BF16.gguf
    sample_rate: 16000
    languages:
    - ja
    - en
    vram_estimate_mb: 2100
    context_window_sec: 30
    description: Qwen3 ASR 1.7B JA (BF16) converted via transcribe.cpp pipeline
  qwen3-asr-1.7b-ja-q8-0:
    name: Qwen3 ASR 1.7B JA (Q8_0)
    family: qwen3_asr
    architecture_type: offline_llm
    hf_repo: neosophie/Qwen3-ASR-1.7B-JA
    default_quant: Q8_0
    file: Qwen3-ASR-1.7B-JA-Q8_0.gguf
    sample_rate: 16000
    languages:
    - ja
    - en
    vram_estimate_mb: 2100
    context_window_sec: 30
    description: Qwen3 ASR 1.7B JA (Q8_0) converted via transcribe.cpp pipeline
  mod-sencevoice-q8-0:
    name: mod sencevoice (Q8_0)
    family: sensevoice
    architecture_type: non_autoregressive
    hf_repo: nelmo-ux/mod-sencevoice
    default_quant: Q8_0
    file: mod-sencevoice-Q8_0.gguf
    sample_rate: 16000
    languages:
    - ja
    vram_estimate_mb: 500
    description: mod sencevoice (Q8_0) converted via transcribe.cpp pipeline
  mod-sencevoice-bf16:
    name: mod sencevoice (BF16)
    family: sensevoice
    architecture_type: non_autoregressive
    hf_repo: nelmo-ux/mod-sencevoice
    default_quant: BF16
    file: mod-sencevoice-BF16.gguf
    sample_rate: 16000
    languages:
    - ja
    vram_estimate_mb: 500
    description: mod sencevoice (BF16) converted via transcribe.cpp pipeline
